# 网易云音乐 Cookie (登录后自动获取，也可手动填入)
NETEASE_COOKIE=

# Azure TTS 配置
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=zh-CN-Xiaoxiao:DragonHDFlashLatestNeural
AZURE_TTS_STYLE=gentle

# LLM 配置 (DeepSeek)
LLM_API_KEY=
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_LIGHT_MODEL=deepseek-chat

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=uradiodata
